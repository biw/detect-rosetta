{
  "name": "detect-rosetta",
  "version": "1.0.0",
  "description": "Detect if a Node.js process is running under Rosetta translation on macOS",
  "keywords": [
    "addon",
    "apple-silicon",
    "arm64",
    "macos",
    "napi",
    "native",
    "rosetta",
    "rosetta2",
    "translation",
    "x86_64"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biw/detect-rosetta.git"
  },
  "files": [
    "dist",
    "prebuilds"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "build:native": "node-gyp rebuild",
    "check": "vp check",
    "clean": "node-gyp clean && rm -rf dist",
    "install": "node -e \"process.exit(0)\"",
    "lint": "vp lint",
    "prebuild": "prebuildify --napi --strip",
    "test": "vp test run",
    "prepublishOnly": "pnpm run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "node-gyp": "^12.1.0",
    "prebuildify": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
